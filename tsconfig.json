{
    "compilerOptions": {
      "target": "es2016",
      "module": "commonjs",
      "rootDir": "./packages",
      "outDir": "./dist",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true
    },
    "include": ["packages/**/*"],
    "exclude": ["node_modules", "dist"]
  }